# ============================================================
# astro-starter-static — Environment Variables
# ============================================================
#
# TEMPLATE ONLY. Copy to .env for local development.
# Never commit real secrets. .env is gitignored.
#
# Cloudflare's documented dummy Turnstile keys are included so
# `npm run build` and local form markup work out of the box.
# They always pass / always fail on purpose — they are not a
# client site's keys. Replace them before any production deploy.
#
# Dummy key source (public, not secret):
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# ============================================================

# Public origin of the finished site. Must match astro.config.mjs `site`.
PUBLIC_SITE_URL=https://example.com

# ------------------------------------------------------------
# BUILD-TIME — baked into HTML by Astro
# Set in GitHub Actions secrets / Cloudflare Pages build env.
# ------------------------------------------------------------

# Cloudflare Turnstile site key (public, rendered into the widget).
# Dummy always-passes key for template development:
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# CookieYes site key (Quebec Law 25 / GDPR / CCPA). Public. Unset = no banner.
# Get it from the CookieYes dashboard after adding the client domain.
COOKIEYES_SITE_KEY=

# Google Tag Manager container ID. Format: GTM-XXXXXXX
# Unset = no GTM script. Prefer this over standalone GA4 when both exist.
GTM_CONTAINER_ID=

# Google Analytics 4 measurement ID. Format: G-XXXXXXXXXX
# Use ONLY when GTM is not configured — loading both double-fires events.
GA4_MEASUREMENT_ID=

# Meta (Facebook) Pixel ID — optional, only if running Meta Ads.
META_PIXEL_ID=

# Microsoft Clarity project ID — optional heatmaps / session replay.
MS_CLARITY_PROJECT_ID=

# CallRail company id for swap.js (cdn.callrail.com/companies/{id}/…).
# This is the COMPANY id in the snippet path, not the runtime account id
# the WordPress starter's leads proxy uses. Unset = no swap.js.
CALLRAIL_ACCOUNT_ID=

# Optional CallRail snippet key. Completes …/{id}/{key}/12/swap.js.
# Leave empty unless the CallRail dashboard snippet includes one.
CALLRAIL_SWAP_KEY=

# ------------------------------------------------------------
# RUNTIME — Pages Functions only (functions/api/lead.js)
# Set in Cloudflare Pages → Settings → Environment variables
# (or `npx wrangler pages secret put …`).
# GitHub Actions secrets do NOT reach Functions.
# ------------------------------------------------------------

# Server-side Turnstile verification. REQUIRED in production.
# Without it the handler rejects every submission (fails closed).
# Dummy always-passes secret for local `wrangler pages dev`:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: Cloudflare Email Sending (best-effort notification after D1 write)
# CF_ACCOUNT_ID=
# CF_EMAIL_TOKEN=
# NOTIFY_TO=hello@example.com
# NOTIFY_FROM=leads@example.com

# Optional: admin portal password for GET /api/leads-data
# ADMIN_PASS=

# Optional: forward a copy of each lead to a CRM / Zapier hook
# CRM_WEBHOOK_URL=
# MASTER_GHL_WEBHOOK_URL=
