---
/**
 * MicrosoftClarity — heatmaps + session replay loader.
 *
 * Renders only when MS_CLARITY_PROJECT_ID is set.
 *
 * Loading: native, CookieYes auto-blocker.
 *   - Script is `type="text/plain"` + `data-cookieyes="cookieyes-analytics"`
 *   - CookieYes upgrades the type after the Analytics category is accepted
 *
 * CSP: script-src / connect-src for www.clarity.ms and *.clarity.ms.
 */
const projectId = import.meta.env.MS_CLARITY_PROJECT_ID;
---

{
  projectId && (
    <script type="text/plain" data-cookieyes="cookieyes-analytics" is:inline define:vars={{ projectId }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', projectId);
    </script>
  )
}
