---
/**
 * SchemaFAQPage — FAQ pages and FAQ sections.
 *
 * Google's FAQPage rich results require every listed question to be
 * publicly visible on the page. Do not pass questions that are not rendered.
 */
import { compact, serializeJsonLd } from '~/lib/schema';

interface QA {
  question: string;
  answer: string;
}

interface Props {
  questions: QA[];
}

const { questions } = Astro.props;

const graph = compact({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((qa) => ({
    '@type': 'Question',
    name: qa.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: qa.answer,
    },
  })),
});
---

{
  questions.length > 0 && (
    <script type="application/ld+json" is:inline set:html={serializeJsonLd(graph)} />
  )
}
