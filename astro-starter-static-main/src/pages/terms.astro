---
import { getEntry, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Heading from '~/components/seo/Heading.astro';

const entry = await getEntry('legal', 'terms');
if (!entry) throw new Error('Missing src/content/legal/terms.md');
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  breadcrumb={[{ name: 'Terms', href: '/terms/' }]}
>
  <main class="wrap pt-[2.4rem] pb-[3.4rem]">
    <Heading level={1}>{entry.data.heading}</Heading>
    <p class="text-muted">Last updated {entry.data.lastUpdated}</p>
    <Content />
  </main>
</BaseLayout>
