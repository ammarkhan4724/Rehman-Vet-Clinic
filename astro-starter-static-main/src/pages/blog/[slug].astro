---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Heading from '~/components/seo/Heading.astro';
import Image from '~/components/seo/Image.astro';
import SchemaArticle from '~/components/schema/SchemaArticle.astro';
import { site } from '~/data/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const url = new URL(`/blog/${entry.id}/`, site.url).href;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  navActive="blog"
  ogType="article"
  ogImage={entry.data.image?.src}
  breadcrumb={[
    { name: 'Journal', href: '/blog/' },
    { name: entry.data.title, href: `/blog/${entry.id}/` },
  ]}
>
  <Fragment slot="head">
    <SchemaArticle
      headline={entry.data.title}
      description={entry.data.description}
      url={url}
      image={entry.data.image?.src}
      authorName={entry.data.author}
      datePublished={entry.data.date.toISOString()}
    />
  </Fragment>

  <main class="wrap pt-[2.4rem] pb-[3.4rem]">
    <Heading level={1}>{entry.data.title}</Heading>
    <p class="text-muted">{entry.data.date.toISOString().slice(0, 10)} · {entry.data.author}</p>
    {
      entry.data.image && (
        <Image src={entry.data.image.src} alt={entry.data.image.alt} width={1200} height={630} />
      )
    }
    <Content />
  </main>
</BaseLayout>
