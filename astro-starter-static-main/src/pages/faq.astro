---
import { getEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Heading from '~/components/seo/Heading.astro';
import SchemaFAQPage from '~/components/schema/SchemaFAQPage.astro';

const entry = await getEntry('faq', 'faq');
if (!entry) throw new Error('Missing src/content/faq/faq.yaml');
const page = entry.data;
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  navActive={page.navActive}
  breadcrumb={[{ name: 'FAQ', href: '/faq/' }]}
>
  <Fragment slot="head">
    <SchemaFAQPage questions={page.items} />
  </Fragment>

  <main class="wrap pt-[2.4rem] pb-[3.4rem]">
    <Heading level={1}>{page.heading}</Heading>
    <p class="text-[1.15rem] text-muted">{page.lede}</p>
    {page.items.map((item) => (
      <article class="mt-4 first:mt-0 rounded-card border border-line bg-bg-raised px-5 py-[1.2rem]">
        <Heading level={2} class="text-[1.2rem]">{item.question}</Heading>
        <p class="mb-0">{item.answer}</p>
      </article>
    ))}
  </main>
</BaseLayout>
