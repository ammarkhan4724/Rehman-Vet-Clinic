---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Heading from '~/components/seo/Heading.astro';
import SchemaService from '~/components/schema/SchemaService.astro';
import { site } from '~/data/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const url = new URL(`/services/${entry.id}/`, site.url).href;
---

<BaseLayout
  title={entry.data.seo.title}
  description={entry.data.seo.description}
  navActive="services"
  breadcrumb={[
    { name: 'Services', href: '/services/' },
    { name: entry.data.name, href: `/services/${entry.id}/` },
  ]}
>
  <Fragment slot="head">
    <SchemaService
      name={entry.data.name}
      description={entry.data.summary}
      url={url}
      serviceType={entry.data.name}
    />
  </Fragment>

  <main class="wrap pt-[2.4rem] pb-[3.4rem]">
    <Heading level={1}>{entry.data.name}</Heading>
    <p class="text-[1.15rem] text-muted">{entry.data.summary}</p>
    <p>{entry.data.body}</p>
  </main>
</BaseLayout>
