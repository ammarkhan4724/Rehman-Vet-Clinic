{
  "name": "astro-starter-static",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Organix Media GitHub template for static Astro client sites with file-based content and no CMS.",
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/lint-build.mjs && node scripts/machine-readable.mjs",
    "build:fast": "astro build",
    "check": "astro check",
    "lint:build": "node scripts/lint-build.mjs",
    "machine": "node scripts/machine-readable.mjs",
    "preview": "astro preview",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "verify": "node scripts/lint-build.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "node-html-parser": "^7.0.1",
    "typescript": "^6.0.3",
    "yaml": "^2.8.1"
  }
}
