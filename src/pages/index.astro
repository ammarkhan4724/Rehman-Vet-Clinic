---
import App from '../App.tsx';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7RT8KMREC6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7RT8KMREC6');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rehman Veterinary Clinic — Mobile Vet & 24/7 Video Care in Lahore</title>
    
    <!-- Core SEO Meta Tags -->
    <meta name="description" content="Looking for a vet near me? Rehman Veterinary Clinic provides 24/7 emergency pet care, mobile house call vet visits, pet surgery, and routine vaccinations across Lahore. Call or WhatsApp Dr. Saif at +92 311 4899904." />
    <meta name="keywords" content="veterinary clinic lahore, emergency vet lahore, home visit vet lahore, 24 hour animal hospital lahore, pet vaccination cost pakistan, pet surgery lahore, dr rehman vet" />
    <meta name="author" content="Dr. Saif Ur Rehman, DVM" />
    <meta name="geo.region" content="PK-PB" />
    <meta name="geo.placename" content="Lahore" />

    <!-- Open Graph / Social Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rehmanvetclinic.com/" />
    <meta property="og:title" content="Rehman Veterinary Clinic — Mobile Vet & 24/7 Video Care in Lahore" />
    <meta property="og:description" content="The vet comes to you day or night. Mobile vet house calls across Lahore and 24/7 urgent video consults. Contact +92 311 4899904." />
    <meta property="og:site_name" content="Rehman Veterinary Clinic" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Rehman Veterinary Clinic — Mobile Vet & 24/7 Video Care" />
    <meta name="twitter:description" content="Mobile vet house calls across Lahore & 24/7 emergency video care. Phone / WhatsApp: +92 311 4899904." />

    <!-- Structured Data (VeterinaryCare Schema.org JSON-LD) -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "VeterinaryCare",
      "@id": "https://rehmanvetclinic.com/#clinic",
      "name": "Rehman Veterinary Clinic",
      "legalName": "Rehman Veterinary Clinic Lahore",
      "url": "https://rehmanvetclinic.com/",
      "telephone": "+923114899904",
      "email": "info@rehmanvetclinic.com",
      "priceRange": "PKR",
      "image": "https://images.pexels.com/photos/7468978/pexels-photo-7468978.jpeg?auto=compress&w=800&h=900&fit=crop",
      "description": "Professional mobile veterinary services, 24/7 emergency video consultations, pet surgery, and preventive pet vaccinations across Lahore, Pakistan.",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lahore",
        "addressRegion": "Punjab",
        "addressCountry": "PK"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 31.5204,
        "longitude": 74.3587
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday"
          ],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "areaServed": [
        {
          "@type": "City",
          "name": "Lahore"
        },
        {
          "@type": "City",
          "name": "Islamabad"
        },
        {
          "@type": "City",
          "name": "Rawalpindi"
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Veterinary Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Mobile Home Visit Veterinary Exam",
              "description": "Complete physical exam at your doorstep in Lahore. Full medical kit, vaccinations, and diagnostic evaluation."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "24/7 Urgent Pet Video Consultation",
              "description": "Round-the-clock live video triage with licensed veterinarian Dr. Saif for urgent pet conditions."
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "Pet Vaccinations at Home",
              "description": "Essential dog and cat vaccines administered stress-free at home with official medical immunization records."
            }
          }
        ]
      }
    }
    </script>
  </head>
  <body>
    <!-- Renders the React App component on the server for perfect SEO, and hydrates it on the client for interactivity -->
    <App client:load />
  </body>
</html>
