---
import '../../styles/global.css';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Feed Orphan Newborn Kittens with KMR (Kitten Milk Replacer) in Pakistan",
  "description": "Veterinary clinical protocol for nursing newborn orphaned kittens using KMR milk replacer and feeder bottles by Dr. Saif Ur Rehman, DVM. Mixing ratios, feeding charts, temperature control, burping, stimulation, and weaning.",
  "image": "https://rehmanvetclinic.com/images/products/petag-kmr-kitten-milk-powder.jpg",
  "estimatedCost": {
    "@type": "MonetaryAmount",
    "currency": "PKR",
    "value": "7950"
  },
  "step": [
    {
      "@type": "HowToStep",
      "name": "Prepare the KMR Milk Formula",
      "text": "Mix 1 part KMR powder with 2 parts warm sterile water (approx 100°F or 38°C). Stir until completely smooth with zero lumps."
    },
    {
      "@type": "HowToStep",
      "name": "Check Teat Flow and Temperature",
      "text": "Fill the pet nursing feeder bottle and drop a small bead of milk onto your inner wrist to ensure it is warm, not scalding. Ensure teat drips slowly when inverted."
    },
    {
      "@type": "HowToStep",
      "name": "Position Kitten on Its Belly",
      "text": "Never feed a kitten on its back like a human baby. Place the kitten horizontally on its tummy with head tilted slightly upwards to prevent lung aspiration."
    },
    {
      "@type": "HowToStep",
      "name": "Stimulate Urination and Defecation",
      "text": "Kittens under 3 weeks cannot urinate or poop on their own. After feeding, gently rub the genital and anal region with a warm, damp cotton pad."
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I give cow's milk, buffalo milk, or Olpers to a newborn kitten in Pakistan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "NEVER give cow's milk, packaged UHT milk (Olpers, MilkPak), or buffalo milk to kittens. Feline milk contains very high protein and fat with minimal lactose. Cow's milk contains high lactose and deficient fat, causing acute osmotic diarrhea, severe dehydration, and hypothermic death within 24 to 48 hours. Only use specialized Kitten Milk Replacer (KMR)."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I buy original PetAg KMR Kitten Milk in Lahore and Pakistan?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Authentic USA-imported PetAg KMR Powder (340g) and graduated nursing feeder bottle kits can be ordered directly from Rehman Veterinary Clinic's official Pet Pharmacy (/shop) with same-day doorstep delivery in Lahore and expedited 2-day delivery across Pakistan."
      }
    },
    {
      "@type": "Question",
      "name": "How often should a newborn kitten be fed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Kittens aged 0 to 7 days require feeding every 2 to 3 hours around the clock (8 to 10 feedings per 24 hours). Kittens aged 2 weeks need feeding every 3 to 4 hours. By 3 to 4 weeks, feeding intervals extend to every 4 to 5 hours, transitioning to kitten weaning food."
      }
    },
    {
      "@type": "Question",
      "name": "What should I do if the kitten breathes in milk while feeding?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If milk bubbles emerge from the kitten's nose or it begins gasping, immediately stop feeding. Hold the kitten securely facing downwards and gently wipe the nose. Aspiration pneumonia can develop rapidly if milk enters the lungs. Contact Dr. Saif immediately at +92 311 4899904 for emergency stabilization."
      }
    }
  ]
};
