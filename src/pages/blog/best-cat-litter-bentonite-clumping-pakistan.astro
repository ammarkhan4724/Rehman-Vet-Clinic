            </p>
            <div class="mt-3 flex items-center gap-3 text-xs font-bold">
              <a href="tel:+923114899904" class="text-slate-900 hover:text-emerald-700 transition">📞 +92 311 4899904</a>
              <span>•</span>
              <a href="https://wa.me/923114899904" class="text-[#25D366] hover:underline">WhatsApp Direct</a>
            </div>
          </div>
        </div>
      </main>

      {/* Footer */}
      <SiteFooter />
    </div>
  </body>
</html>
