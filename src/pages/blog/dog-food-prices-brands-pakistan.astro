            </p>
          </div>

          <div>
            <h2 class="text-2xl font-black text-slate-900 mb-3">6. Frequently Asked Questions (FAQ)</h2>
            <div class="space-y-4">
              {faqSchema.mainEntity.map((faq) => (
                <div class="p-5 rounded-2xl bg-white border border-slate-200">
                  <h3 class="font-bold text-slate-900 text-sm mb-2">{faq.name}</h3>
                  <p class="text-xs text-slate-600 leading-relaxed">{faq.acceptedAnswer.text}</p>
                </div>
              ))}
            </div>
          </div>
        </article>

        {/* Doctor Author Bio Box */}
        <div class="mt-12 bg-white rounded-3xl p-6 md:p-8 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center gap-6">
          <div class="w-20 h-20 rounded-2xl bg-emerald-950 border-2 border-emerald-500 text-white grid place-items-center font-black text-2xl shrink-0 shadow-md">
            SR
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-black text-slate-900 text-lg">Dr. Saif Ur Rehman, DVM</h3>
              <span class="text-[10px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">
                PVMC Registered
              </span>
            </div>
            <p class="text-xs text-slate-500 mt-1">
              Chief Veterinary Surgeon at Rehman Veterinary Clinic. Dedicated to guiding pet owners on optimal canine nutrition and holistic health management.
            </p>
            <div class="mt-3 flex items-center gap-3 text-xs font-bold">
              <a href="tel:+923114899904" class="text-slate-900 hover:text-emerald-700 transition">📞 +92 311 4899904</a>
              <span>•</span>
              <a href="https://wa.me/923114899904" class="text-[#25D366] hover:underline">WhatsApp Direct</a>
            </div>
          </div>
        </div>
      </main>

      {/* Footer */}
      <SiteFooter />
    </div>
  </body>
