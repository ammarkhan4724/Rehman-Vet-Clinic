          <div class="w-20 h-20 rounded-2xl bg-emerald-950 border-2 border-emerald-500 text-white grid place-items-center font-black text-2xl shrink-0 shadow-md">
            SR
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h3 class="font-black text-slate-900 text-lg">Dr. Saif Ur Rehman, DVM</h3>
              <span class="text-[10px] font-extrabold uppercase tracking-wider bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full">
                PVMC Registered
              </span>
