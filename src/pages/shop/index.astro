---
import ShopCatalog, { PRODUCTS } from '../../components/ShopCatalog';
import '../../styles/global.css';

// Schema ItemList generator
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Veterinary Pet Shop & Pharmacy — Rehman Vet Clinic Lahore",
  "description": "Authentic cat food, kitten milk replacers, bentonite cat litter, orthopedic pet beds, harnesses, and veterinary-grade deworming medications in Pakistan.",
  "itemListElement": PRODUCTS.map((p, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "item": {
      "@type": "Product",
      "name": p.name,
      "image": p.image,
      "description": p.description,
      "category": p.categoryLabel,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "PKR",
        "price": p.price,
        "availability": "https://schema.org/InStock",
        "seller": {
          "@type": "VeterinaryCare",
          "name": "Rehman Veterinary Clinic"
        }
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": p.rating,
        "reviewCount": p.reviewCount
      }
    }
  }))
};
