        </a>
        
        <a href="/locations/dha-lahore-veterinary-clinic" class="block p-5 rounded-2xl bg-white border border-slate-100 hover:border-emerald-300 shadow-sm hover:shadow-md transition group">
          <h4 class="font-bold text-slate-900 text-sm group-hover:text-emerald-700 transition mb-1">Mobile Vet in DHA Lahore</h4>
          <p class="text-xs text-slate-500 line-clamp-2">Doorstep animal doctor service across all phases of DHA Lahore.</p>
          <span class="text-xs font-semibold text-emerald-600 mt-2 inline-flex items-center gap-1">Read Service Guide →</span>
        </a>
        
      </div>
    </section>
    
    
      </main>
    </div>
    
    <!-- Footer -->
    <SiteFooter />

    <!-- Floating WhatsApp Widget -->
    
    
  </body>
</html>
