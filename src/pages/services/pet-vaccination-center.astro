    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pet Vaccination Price in Pakistan (2026) — Dogs & Cats Vaccination Lahore</title>
    
    <!-- Core SEO Meta Tags -->
    <meta name="description" content="Complete 2026 dog and cat vaccination price guide in Lahore, Pakistan. Canine 7-in-1, 9-in-1, Rabies, and feline Tricat immunizations at clinic or at home. Call +92 311 4899904." />
